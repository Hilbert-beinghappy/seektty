{
  "name": "seektty",
  "version": "1.2.5",
  "description": "SeekTTY, a pluggable DeepSeek-colored terminal surface for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "seektty",
    "tui"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbert-beinghappy/seektty.git"
  },
  "homepage": "https://github.com/Hilbert-beinghappy/seektty#readme",
  "bugs": "https://github.com/Hilbert-beinghappy/seektty/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./startup": "./lib/startup.js",
    "./marketplace-provider": "./lib/marketplace-provider.js",
    "./in-process": "./lib/in-process.js",
    "./attachment-compat": "./lib/attachment-compat.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "deepseek": "./lib/bin.js"
  },
  "files": [
    "lib/*.js",
    "assets/seektty-logo.png",
    "assets/seektty-welcome-logo.json",
    "assets/seektty-tui.png",
    "assets/seektty-tui-dark.png",
    "assets/seektty-code-light.png",
    "assets/seektty-code-dark.png",
    "assets/seektty-onboarding-light.png",
    "assets/seektty-onboarding-dark.png",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "minimum": "0.1.0-rc.6",
      "tested": "0.1.1-rc.2"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf:tui": "node scripts/tui-perf-harness.mjs",
    "test:stock": "node scripts/stock-dsh-cycle.mjs",
    "test:pnpm11-layout": "node scripts/pnpm11-layout-acceptance.mjs",
    "test:clarify-doctor": "node scripts/clarify-doctor-acceptance.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "test:mouse-pty": "node scripts/mouse-pty-harness.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check"
  },
  "dependencies": {
    "@shikijs/core": "4.4.3",
